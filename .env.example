# Required
SERVICE_NAME=axion-school-api
ENV=development
USER_PORT=5111

# MongoDB
MONGO_URI=mongodb://localhost:27017/axion-school-api

# JWT secrets (generate strong values)
LONG_TOKEN_SECRET=change_me_long_secret
SHORT_TOKEN_SECRET=change_me_short_secret
NACL_SECRET=change_me_nacl_secret

# Redis (optional for cortex/cache)
REDIS_URI=redis://127.0.0.1:6379
CORTEX_REDIS=redis://127.0.0.1:6379
CACHE_REDIS=redis://127.0.0.1:6379
OYSTER_REDIS=redis://127.0.0.1:6379
